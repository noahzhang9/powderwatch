{
  "name": "powderwatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "build:local": "VITE_SNAPSHOT_ONLY=1 npm run build",
    "preview:local": "npm run build:local && npm run preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "obs": "tsx scripts/fetch-obs.ts",
    "snapshot": "tsx scripts/snapshot-forecasts.ts",
    "backfill:verification": "tsx scripts/backfill-verification.ts",
    "backfill:snodas": "tsx scripts/backfill-snodas.ts"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
